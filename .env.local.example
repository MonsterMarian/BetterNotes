# Údaje k Supabase projektu, přes který chodí poznámky z telefonu do počítače.
#
# Zkopíruj tenhle soubor jako `.env.local` a vyplň. `.env.local` je mimo git,
# takže se heslo nikam nenahraje.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://neco.supabase.co

# Tamtéž → API Keys → anon / public.
# Je veřejný z definice: zabalí se do APK a přečte si ho kdokoli. Samotný
# nedává přístup k ničemu, data drží u sebe až RLS policy v databázi.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Účet, pod kterým si počítač vyzvedává poznámky. Stejný, jakým se přihlásíš
# v telefonu — podle něj databáze pozná, čí poznámky jsou.
# Tohle heslo je skutečné heslo, na rozdíl od klíče výš. Do gitu nepatří.
BETTERNOTES_EMAIL=ty@example.com
BETTERNOTES_PASSWORD=
